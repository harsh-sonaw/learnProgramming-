# Copy to .env (git-ignored) and adjust. Only VITE_* variables reach the browser.
# NEVER put secrets (API keys, tokens) in a VITE_* variable: every visitor can read them.

# Backend API (only used when VITE_ENABLE_REMOTE_API=true). Leave empty for same origin.
VITE_API_BASE_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=10000

# "false": save progress in the browser (localStorage). "true": save through the API.
VITE_ENABLE_REMOTE_API=false

# Public URL of the deployed site.
VITE_APP_URL=
